<!-- Основные цвета NebulaGram -->
<color name="colorPrimary">#0B0C10</color> <!-- Темный фон (почти черный) -->
<color name="colorPrimaryDark">#000000</color> <!-- Самый темный (для статус-бара) -->
<color name="colorAccent">#4A90E2</color> <!-- Яркий синий (кнопки, галочки) -->

<!-- Цвета для чатов (чтобы не сливалось) -->
<color name="chat_inBubble">#1F2833</color> <!-- Фон входящих сообщений -->
<color name="chat_outBubble">#4A90E2</color> <!-- Фон твоих сообщений (синий) -->
<color name="chat_messageTextIn">#FFFFFF</color> <!-- Белый текст на темном -->
<color name="chat_messageTextOut">#FFFFFF</color> <!-- Белый текст на синем -->
